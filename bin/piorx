#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
EXTENSION_PATH="$REPO_DIR/extensions/conductor-extension.ts"

if ! command -v pi >/dev/null 2>&1; then
  echo "pi is not installed. Run: npm run install:pi" >&2
  exit 1
fi

if [[ ! -f "$EXTENSION_PATH" ]]; then
  echo "Missing extension entrypoint: $EXTENSION_PATH" >&2
  exit 1
fi

exec pi -e "$EXTENSION_PATH" "$@"
